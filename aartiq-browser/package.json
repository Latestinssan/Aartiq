{
  "name": "Aartiq",
  "version": "0.3.8",
  "private": true,
  "license": "Apache-2.0",
  "description": "Aartiq Browser - A high-performance, intelligence-driven browsing workspace with local LLM support and advanced productivity features.",
  "author": "Latestinssan",
  "main": "main.js",
  "bin": {
    "aartiq": "./scripts/aartiq-cli.js"
  },
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm:electron-dev\" \"wait-on http://localhost:3003 && electron .\"",
    "electron-dev": "next dev -p 3003",
    "electron-start": "electron .",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:extraction": "NODE_OPTIONS='--experimental-vm-modules' jest tests/extraction.test.js",
    "test:extraction:live": "electron tests/live-extraction-test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "predev": "npx tsc src/lib/P2PFileSyncService.ts src/lib/WiFiSyncService.ts src/lib/modelRegistry.ts src/lib/CloudSyncService.ts src/types/electron.d.ts --outDir src/lib --module CommonJS --skipLibCheck --esModuleInterop",
    "test:prod": "node test-production.js",
    "prebuild-electron": "node verify-build.js",
    "build-macos-helper": "node scripts/build-macos-device-unlock-helper.js",
    "build-macos-apple-intelligence-helper": "node scripts/build-apple-intelligence-helper.js",
    "build-macos-native-panels": "node scripts/build-macos-native-panels.js",
    "build-siri-bridge": "bash scripts/build-siri-bridge.sh",
    "build-electron": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win --x64",
    "electron:build:mac": "npm run build-macos-helper && npm run build-macos-apple-intelligence-helper && npm run build-macos-native-panels && npm run build-siri-bridge && npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run dist:mac:arm64",
    "dist:mac:arm64": "npm run build-macos-helper && npm run build-macos-apple-intelligence-helper && npm run build-macos-native-panels && npm run build-siri-bridge && npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:local": "npm run build-macos-helper && npm run build-macos-apple-intelligence-helper && npm run build-macos-native-panels && npm run build-siri-bridge && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --publish never",
    "dist:mac:signed": "npm run build-macos-helper && npm run build-macos-apple-intelligence-helper && npm run build-macos-native-panels && npm run build-siri-bridge && npm run build && electron-builder --mac --arm64 --publish never -c.mac.hardenedRuntime=true -c.mac.entitlements=entitlements.mac.plist -c.mac.entitlementsInherit=entitlements.mac.plist",
    "dist:mac:universal": "npm run build-macos-helper && npm run build-macos-apple-intelligence-helper && npm run build-macos-native-panels && npm run build-siri-bridge && npm run build && electron-builder --mac --universal --publish never",
    "dist:mac:x64": "npm run build-macos-helper && npm run build-macos-apple-intelligence-helper && npm run build-macos-native-panels && npm run build-siri-bridge && npm run build && electron-builder --mac --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux",
    "rebuild": "electron-rebuild",
    "rebuild:native": "electron-rebuild -f -w sharp",
    "postinstall": "electron-builder install-app-deps",
    "generate-appx-assets": "node scripts/generate-appx-assets.js",
    "check-dups": "node check_dups.js",
    "service": "electron src/service/service-main.js",
    "service:install": "node scripts/install-service.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/groq": "^3.0.31",
    "@ai-sdk/mcp": "^1.0.30",
    "@ai-sdk/openai": "^3.0.47",
    "@ai-sdk/xai": "^3.0.72",
    "@beeper/webauthn-authenticator": "^0.2.1",
    "@ghostery/adblocker-electron": "^2.14.1",
    "@googleapis/gmail": "^16.1.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@mozilla/readability": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "ai": "^6.0.134",
    "ai-sdk-ollama": "^3.8.0",
    "autoprefixer": "^10.4.23",
    "body-parser": "^2.2.2",
    "cbor-x": "^1.6.4",
    "chart.js": "^4.5.1",
    "cross-fetch": "^4.1.0",
    "docx": "^8.5.0",
    "dompurify": "^3.4.11",
    "electron-context-menu": "^4.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "es-errors": "^1.3.0",
    "express": "^5.2.1",
    "firebase": "^12.7.0",
    "framer-motion": "^12.23.26",
    "googleapis": "^171.4.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.9.0",
    "mysql2": "^3.11.5",
    "nanoid": "^3.3.11",
    "node-cron": "^3.0.3",
    "object-inspect": "^1.13.3",
    "pdf-lib": "^1.17.1",
    "pdf-lib-table": "^1.1.7",
    "pdfjs-dist": "^4.10.38",
    "pdfmake": "^0.2.18",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "qs": "^6.13.1",
    "remark-breaks": "^4.0.0",
    "screenshot-desktop": "^1.15.3",
    "sharp": "^0.34.5",
    "side-channel": "^1.1.0",
    "smiles-drawer": "^2.4.1",
    "tesseract.js": "^7.0.0",
    "wait-on": "^9.0.3",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@cherrystudio/mac-system-ocr": "^0.2.7",
    "@nut-tree/nut-js": "^4.2.0",
    "rusto": "^0.1.0",
    "uniocr": "^0.1.0",
    "xa11y": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@eslint/compat": "^2.0.1",
    "@jest/globals": "^30.3.0",
    "@next/eslint-plugin-next": "^16.1.4",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.1.36",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/tesseract.js": "^0.0.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^13.24.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "katex": "^0.16.27",
    "mocha": "^11.7.5",
    "next": "^16.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.1",
    "react-pdftotext": "^1.3.4",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.53.1",
    "zustand": "^5.0.9"
  },
  "packageManager": "npm@11.5.1",
  "build": {
    "appId": "com.latestinssan.aartiqbrowser",
    "productName": "Aartiq",
    "copyright": "Copyright © 2026 Latestinssan",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "scripts/**/*"
    ],
    "files": [
      "out/**/*",
      "main.js",
      "preload.js",
      "auth-preload.js",
      "approval-preload.js",
      "view_preload.js",
      "src/lib/**/*",
      "src/service/**/*",
      "src/automation/**/*",
      "src/core/**/*",
      "src/main/**/*",
      "assets/**/*",
      "bin/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.txt",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aartiq"
    },
    "win": {
      "icon": "assets/icon-transparent.png",
      "target": [
        "nsis",
        "appx"
      ]
    },
    "appx": {
      "identityName": "Latestinssan.Aartiq",
      "publisher": "CN=CF2DF47B-A710-4E1D-8C29-FC648FFA1CAE",
      "publisherDisplayName": "Latestinssan",
      "applicationId": "Aartiq",
      "displayName": "Aartiq",
      "backgroundColor": "#000000",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.local.plist",
      "entitlementsInherit": "entitlements.mac.local.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Aartiq needs Bluetooth to communicate with passkeys and security keys via FIDO/WebAuthn.",
        "NSBluetoothPeripheralUsageDescription": "Aartiq needs Bluetooth to communicate with passkeys and security keys via FIDO/WebAuthn."
      }
    },
    "linux": {
      "icon": "assets/icon-transparent.png",
      "target": [
        "AppImage"
      ],
      "category": "Network;WebBrowser"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "protocols": [
      {
        "name": "Aartiq Browser Auth",
        "schemes": [
          "aartiq-browser"
        ]
      },
      {
        "name": "Aartiq Shortcuts",
        "schemes": [
          "aartiq"
        ]
      },
      {
        "name": "HTTP Web Links",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
