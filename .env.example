# [1] APP CONFIGURATION
NEXT_PUBLIC_APP_NAME="Aartiq"

# [2] FIREBASE CONFIGURATION (Required for Google Login & Auth)
# Get these from Firebase Console > Project Settings
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# [3] DATABASE CONFIGURATION (MySQL / Hostinger)
# Used for persistent history, bookmarks, and user metadata
DB_HOST="your_db_host"
DB_USER="your_db_user"
DB_PASSWORD="your_db_password"
DB_DATABASE="your_db_name"

# [4] OPENAI API KEY (Required for AI features)
OPENAI_API_KEY="your_openai_api_key"

# [5] WEB SEARCH API KEY — exactly one is enough, and having none is supported.
#
# With NO key below, search still runs: Aartiq scrapes a search engine's HTML.
# Scraped results are rate-limited, slower, and break without warning when the
# engine changes its markup, so responses are tagged `scraped: true`. Any response
# carries that flag — check it before treating results as authoritative.
#
# TAVILY_API_KEY is the recommended default: 1,000 free credits/month, no card.
#   https://tavily.com          -> TAVILY_API_KEY="tvly-..."
# BRAVE_API_KEY: ~1,000 requests/month, but requires a card on file and
#   attribution on the built-in search UI.
#   https://brave.com/search/api -> BRAVE_API_KEY="brave-..."
# SERP_API_KEY (also read as SERPAPI_API_KEY): 250 free searches/month.
#   https://serpapi.com         -> SERP_API_KEY="..."
#
# Prefer these over Google Custom Search: the Google CSE JSON API is closed to new
# customers and existing keys end 2027-01-01, so requests to it fall back
# automatically. GOOGLE_API_KEY + GOOGLE_SEARCH_ENGINE_ID are still accepted and
# are now ranked last.
#
# News matters more than it looks. Only a keyed provider has a news index and can
# return real publication dates, and real dates are the only thing that makes
# "which source is most recent" answerable. On the scraped fallback the pipeline
# reports the last source as unknown rather than naming the newest-looking result,
# because recency-of-fetch is not recency-of-publication.
TAVILY_API_KEY=""
# BRAVE_API_KEY=""
# SERP_API_KEY=""
# GOOGLE_API_KEY=""
# GOOGLE_SEARCH_ENGINE_ID=""

# [6] LANDING PAGE URL
NEXT_PUBLIC_LANDING_PAGE_URL="http://localhost:3000"